<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/text_profile_header"
            style="@style/FonosHeadingLarge"
            android:text="Your profile" />

        <LinearLayout
            android:id="@+id/layout_profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_hero_card_gradient"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <View
                android:id="@+id/view_profile_avatar"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_avatar_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fonos Listener"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="example@gmail.com"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_profile_status"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Premium trial"
                    android:textColor="@color/chip_selected_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/FonosProfileLabel"
            android:layout_marginTop="24dp"
            android:text="FULL NAME" />

        <TextView
            style="@style/FonosProfileField"
            android:text="Fonos Listener" />

        <TextView
            style="@style/FonosProfileLabel"
            android:text="PHONE NUMBER" />

        <TextView
            style="@style/FonosProfileField"
            android:text="+84 000 000 000" />

        <TextView
            style="@style/FonosProfileLabel"
            android:text="EMAIL" />

        <TextView
            style="@style/FonosProfileField"
            android:text="example@gmail.com" />

        <TextView
            style="@style/FonosProfileLabel"
            android:text="MEMBERSHIP" />

        <TextView
            style="@style/FonosProfileField"
            android:text="Premium trial" />

        <Button
            android:id="@+id/button_update_profile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:text="Update profile"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_logout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline_dark"
            android:backgroundTint="@null"
            android:text="Log out"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_profile_settings"
            style="@style/FonosHeadingMedium"
            android:layout_marginTop="28dp"
            android:text="Settings" />

        <LinearLayout
            android:id="@+id/layout_profile_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                style="@style/FonosLibraryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/FonosLibraryCardIcon"
                    android:contentDescription="Notifications"
                    android:padding="12dp"
                    android:src="@drawable/ic_notification" />

                <LinearLayout style="@style/FonosBookRowTextGroup">
                    <TextView
                        style="@style/FonosBookRowTitle"
                        android:text="Notifications" />
                    <TextView
                        style="@style/FonosBookRowSubtitle"
                        android:text="Listening reminders and new releases" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/FonosLibraryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/FonosLibraryCardIcon"
                    android:contentDescription="Downloads"
                    android:padding="12dp"
                    android:src="@drawable/ic_download" />

                <LinearLayout style="@style/FonosBookRowTextGroup">
                    <TextView
                        style="@style/FonosBookRowTitle"
                        android:text="Downloads" />
                    <TextView
                        style="@style/FonosBookRowSubtitle"
                        android:text="Offline audiobook preferences" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/FonosLibraryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/FonosLibraryCardIcon"
                    android:contentDescription="Help"
                    android:padding="12dp"
                    android:src="@drawable/ic_headphones" />

                <LinearLayout style="@style/FonosBookRowTextGroup">
                    <TextView
                        style="@style/FonosBookRowTitle"
                        android:text="Help center" />
                    <TextView
                        style="@style/FonosBookRowSubtitle"
                        android:text="Support for your listening account" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
