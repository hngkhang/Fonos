<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/text_library_header"
            style="@style/FonosHeadingLarge"
            android:text="My library" />

        <TextView
            android:id="@+id/text_library_subtitle"
            style="@style/FonosBodyMuted"
            android:layout_marginTop="6dp"
            android:text="Your listening progress, saved titles, and offline audiobooks." />

        <LinearLayout
            android:id="@+id/layout_library_continue_card"
            android:layout_width="match_parent"
            android:layout_height="158dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_hero_card_gradient"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="82dp"
                android:layout_height="116dp"
                android:background="@drawable/bg_cover_green">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Audiobook"
                    android:padding="9dp"
                    android:src="@drawable/ic_headphones" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONTINUE LISTENING"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Deep Work"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cal Newport  |  42% complete"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_progress_track">

                    <View
                        android:layout_width="104dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_progress_fill" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_library_filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_library_saved"
                    style="@style/FonosChipSelected"
                    android:text="Saved" />

                <TextView
                    android:id="@+id/chip_library_loved"
                    style="@style/FonosChipText"
                    android:layout_marginStart="10dp"
                    android:text="Loved" />

                <TextView
                    android:id="@+id/chip_library_listening"
                    style="@style/FonosChipText"
                    android:layout_marginStart="10dp"
                    android:text="Listening" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/text_library_saved_section"
            style="@style/FonosHeadingMedium"
            android:layout_marginTop="28dp"
            android:text="Saved audiobooks" />

        <LinearLayout
            android:id="@+id/layout_library_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/card_library_atomic_habits"
                style="@style/FonosBookRowCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    style="@style/FonosSmallBookCover"
                    android:background="@drawable/bg_cover_blue" />

                <LinearLayout style="@style/FonosBookRowTextGroup">
                    <TextView
                        style="@style/FonosBookRowTitle"
                        android:text="Atomic Habits" />
                    <TextView
                        style="@style/FonosBookRowSubtitle"
                        android:text="James Clear" />
                    <TextView
                        style="@style/FonosBookRowPrice"
                        android:text="5h 20m  |  Saved" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_library_creative_act"
                style="@style/FonosBookRowCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <View
                    style="@style/FonosSmallBookCover"
                    android:background="@drawable/bg_cover_purple" />

                <LinearLayout style="@style/FonosBookRowTextGroup">
                    <TextView
                        style="@style/FonosBookRowTitle"
                        android:text="The Creative Act" />
                    <TextView
                        style="@style/FonosBookRowSubtitle"
                        android:text="Rick Rubin" />
                    <TextView
                        style="@style/FonosBookRowPrice"
                        android:text="5h 45m  |  Downloaded" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_library_ikigai"
                style="@style/FonosBookRowCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <View
                    style="@style/FonosSmallBookCover"
                    android:background="@drawable/bg_cover_orange" />

                <LinearLayout style="@style/FonosBookRowTextGroup">
                    <TextView
                        style="@style/FonosBookRowTitle"
                        android:text="Ikigai" />
                    <TextView
                        style="@style/FonosBookRowSubtitle"
                        android:text="Hector Garcia" />
                    <TextView
                        style="@style/FonosBookRowPrice"
                        android:text="3h 58m  |  Finished" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
